{
  "version": "0.2.0",
  "tasks": [
    {
      "label": "build-wallet-ui",
      "type": "npm",
      "script": "build",
      "options": {
        "cwd": "${workspaceRoot}/apps/wallet-ui"
      }
    },
    {
      "type": "shell",
      "label": "build-wallet-ui",
      "command": "npm run build",
      "group": "test",
      "options": {
        "cwd": "${workspaceRoot}/apps/wallet-ui"
      }
    }
  ],
  "configurations": [
    {
      "name": "Debug Main",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/src/app.ts"],
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Test A",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/src/app.ts"],
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "env": {
        "CONFIG_PATH": "./config.test-a.yaml"
      },
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Test B",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/src/app.ts"],
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "env": {
        "CONFIG_PATH": "./config.test-b.yaml"
      },
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "name": "vscode-jest-tests.v2",
      "request": "launch",
      "program": "${workspaceFolder}/apps/backend/node_modules/jest/bin/jest",
      "args": [
        "--runInBand",
        "--watchAll=false",
        "--testNamePattern",
        "${jest.testNamePattern}",
        "--runTestsByPath",
        "${jest.testFile}"
      ],
      "runtimeArgs": ["--experimental-vm-modules"],
      "cwd": "${workspaceFolder}/apps/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Jest Tests Wallet",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--inspect-brk",
        "${workspaceRoot}/node_modules/.bin/jest",
        "--runInBand",
        "--coverage",
        "false"
      ],
      "outputCapture": "std",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Jest Tests Control Plane",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--inspect-brk",
        "${workspaceRoot}/apps/control-plane-api/node_modules/.bin/jest",
        "--runInBand",
        "--coverage",
        "false"
      ],
      "outputCapture": "std",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Jest Tests HTTP Data Plane",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--inspect-brk",
        "${workspaceRoot}/apps/http-data-plane-api/node_modules/.bin/jest",
        "--runInBand",
        "--coverage",
        "false"
      ],
      "outputCapture": "std",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Main",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/apps/control-plane-api/src/app.ts"],
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Test A",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/apps/control-plane-api/src/app.ts"],
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "env": {
        "CONFIG_PATH": "./config.test-a.yaml"
      },
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Test B Control Plane",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/apps/control-plane-api/src/app.ts"],
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "env": {
        "CONFIG_PATH": "./config.test-b.yaml"
      },
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Wallet Main (without wallet-ui)",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/apps/wallet-api/src/app.ts"],
      "runtimeArgs": ["--nolazy", "--loader", "ts-node/esm"],
      "sourceMaps": true,
      "cwd": "${workspaceRoot}/apps/wallet-api",
      "outputCapture": "std"
    },
    {
      "name": "Debug Main (with wallet-ui)",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceFolder}/apps/wallet-api/src/app.ts"],
      "runtimeArgs": ["--nolazy", "--loader", "ts-node/esm"],
      "sourceMaps": true,
      "env": {
        "EMBEDDED_FRONTEND": "${workspaceRoot}/apps/wallet-ui/dist"
      },
      "cwd": "${workspaceRoot}/apps/wallet-api",
      // "outputCapture": "std",
      "outputCapture": "console",
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "preLaunchTask": "npm: build - wallet-ui"
    }
  ]
}
