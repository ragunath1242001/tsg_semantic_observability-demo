{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Jest Tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--inspect-brk",
        "${workspaceRoot}/apps/backend/node_modules/.bin/jest",
        "--runInBand",
        "--coverage",
        "false"
      ],
      "outputCapture": "std",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Main",
      "type": "node",
      "request": "launch",
      "args": [
        "${workspaceFolder}/apps/backend/src/app.ts"
      ],
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Test A",
      "type": "node",
      "request": "launch",
      "args": [
        "${workspaceFolder}/apps/backend/src/app.ts"
      ],
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register"
      ],
      "env": {
        "CONFIG_PATH": "./config.test-a.yaml"
      },
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Test B",
      "type": "node",
      "request": "launch",
      "args": [
        "${workspaceFolder}/apps/backend/src/app.ts"
      ],
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register"
      ],
      "env": {
        "CONFIG_PATH": "./config.test-b.yaml"
      },
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "outputCapture": "std"
    }
  ]
}