{
  "version": "0.2.0",
  "tasks": [{
    "label": "build-frontend",
    "type": "npm",
    "script": "build",
    "options": {
      "cwd": "${workspaceRoot}/frontend",
    }
  },{
    "type": "shell",
    "label": "build-frontend",
    "command": "npm run build",
    "group": "test",
    "options": {
      "cwd": "${workspaceRoot}/frontend",
    },
  }],
  "configurations": [
    {
      "type": "node",
      "name": "vscode-jest-tests.v2",
      "request": "launch",
      "program": "${workspaceFolder}/backend/node_modules/.bin/jest",
      "args": [
        "--runInBand",
        "--watchAll=false",
        "--testNamePattern",
        "${jest.testNamePattern}",
        "--runTestsByPath",
        "${jest.testFile}"
      ],
      "runtimeArgs": ["--experimental-vm-modules"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest"
      }
    },
    {
        "name": "Debug Jest Tests",
        "type": "node",
        "request": "launch",
        "runtimeArgs": ["--inspect-brk", "${workspaceRoot}/node_modules/.bin/jest", "--runInBand", "--coverage", "false"],
        "outputCapture": "std",
        "internalConsoleOptions": "neverOpen"
    },
    {
        "name": "Debug Main (without frontend)",
        "type": "node",
        "request": "launch",
        "args": ["${workspaceFolder}/backend/src/app.ts"],
        "runtimeArgs": ["--nolazy", "--loader", "ts-node/esm"],
        "sourceMaps": true,
        "cwd": "${workspaceRoot}/backend",
        "outputCapture": "std"
        ,
    },
    {
        "name": "Debug Main (with frontend)",
        "type": "node",
        "request": "launch",
        "args": ["${workspaceFolder}/backend/src/app.ts"],
        "runtimeArgs": ["--nolazy", "--loader", "ts-node/esm"],
        "sourceMaps": true,
        "env": {
          "EMBEDDED_FRONTEND": "${workspaceRoot}/frontend/dist"
        },
        "cwd": "${workspaceRoot}/backend",
        // "outputCapture": "std",
        "outputCapture": "console",
        "console": "integratedTerminal",
        "internalConsoleOptions": "openOnSessionStart",
        "preLaunchTask": "npm: build - frontend"
    }
  ]
}