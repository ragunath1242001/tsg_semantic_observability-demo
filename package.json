{
  "name": "tno-security-gateway",
  "version": "0.11.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter \"./libs/*\" -r build",
    "build:apps": "pnpm --filter \"./apps/*\" -r build",
    "build:apis": "pnpm --filter \"./apps/*-api\" -r build",
    "dev:wallet-ui": "pnpm --filter wallet-ui dev",
    "dev:wallet-api": "pnpm --filter wallet-api dev",
    "dev:wallet": "npm-run-all --parallel \"dev:wallet-api --noClear\" \"dev:wallet-ui --clearScreen=false\"",
    "dev:control-plane-ui": "pnpm --filter control-plane-ui dev",
    "dev:control-plane-api": "pnpm --filter control-plane-api dev",
    "dev:control-plane": "npm-run-all --parallel \"dev:control-plane-api --noClear\" \"dev:control-plane-ui --clearScreen=false\"",
    "dev:http-data-plane-ui": "pnpm --filter http-data-plane-ui dev",
    "dev:http-data-plane-api": "pnpm --filter http-data-plane-api dev",
    "dev:http-data-plane": "npm-run-all --parallel \"dev:http-data-plane-api --noClear\" \"dev:http-data-plane-ui --clearScreen=false\"",
    "dev:analytics-data-plane-ui": "pnpm --filter analytics-data-plane-ui dev",
    "dev:analytics-data-plane-api": "pnpm --filter analytics-data-plane-api dev",
    "dev:analytics-data-plane": "npm-run-all --parallel \"dev:analytics-data-plane-api --noClear\" \"dev:analytics-data-plane-ui --clearScreen=false\"",
    "dev:sso-bridge-api": "pnpm --filter sso-bridge-api dev",
    "dev:sso-bridge-ui": "pnpm --filter sso-bridge-ui dev",
    "dev:sso-bridge": "npm-run-all --parallel \"dev:sso-bridge-api --noClear\" \"dev:sso-bridge-ui --clearScreen=false\"",
    "dev": "pnpm -r dev",
    "dev:embedded": "pnpm --filter frontend build && CONFIG_PATH=\"./config.yaml\" EMBEDDED_FRONTEND=\"../frontend/dist\" pnpm run --filter backend watch",
    "lint": "eslint .",
    "start:control-plane": "pnpm --filter control-plane-api build && pnpm --filter control-plane-api start",
    "start:http-data-plane": "pnpm --filter http-data-plane-api build && pnpm --filter http-data-plane-api start",
    "start:analytics-data-plane": "pnpm --filter analytics-data-plane-api build && pnpm --filter analytics-data-plane-api start",
    "start:sso-bridge": "pnpm --filter sso-bridge-api build && pnpm --filter sso-bridge-api start",
    "start:wallet": "pnpm --filter wallet-api build && pnpm --filter wallet-api start",
    "start:prod": "pnpm --filter backend start",
    "test": "pnpm -r jest",
    "test:coverage": "pnpm -r jest:coverage",
    "test:control-plane-ci": "pnpm --filter control-plane-api jest:ci",
    "test:http-data-plane-ci": "pnpm --filter http-data-plane-api jest:ci",
    "test:analytics-data-plane-ci": "pnpm --filter analytics-data-plane-api jest:ci",
    "test:sso-bridge-ci": "pnpm --filter sso-bridge-api jest:ci",
    "test:wallet-ci": "pnpm --filter wallet-api jest:ci",
    "test:common-dsp-ci": "pnpm --filter common-dsp jest:ci",
    "test:common-api-ci": "pnpm --filter common-api jest:ci",
    "e2e:dsp-local": "pnpm --filter e2e-testing e2e:dsp-local",
    "e2e:dsp-tck": "pnpm --filter e2e-testing e2e:dsp-tck",
    "e2e:dcp-tck": "pnpm --filter e2e-testing e2e:dcp-tck",
    "migrations:check": "pnpm -r migrations:check",
    "migrations:generate": "pnpm -r migrations:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "prebuild-install": "7.1.3",
      "swagger-ui-dist": "-"
    },
    "patchedDependencies": {
      "class-transformer@0.5.1": "patches/class-transformer@0.5.1.patch"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "bcrypt",
      "esbuild",
      "msw",
      "sqlite3",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "npm-run-all2": "^8.0.0",
    "prettier": "^3.5.1",
    "typescript-eslint": "^8.24.1"
  }
}
