{
  "name": "control-plane",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "watch": "tsc-watch --onSuccess \"node ./build/app.js\"",
    "start": "npm run tsc && node ./build/app.js",
    "tsc": "tsc -p tsconfig.json",
    "lint": "eslint . --fix --ext .ts",
    "test": "jest",
    "openapi": "npm run tsc && node ./build/swagger.js",
    "schema:dsp": "typescript-json-schema \"src/model/dsp/**/*.dto.ts\" \"*\" -o resources/schemas/dsp.schema.json",
    "schema:data-planes": "typescript-json-schema \"src/model/data-planes/**/*.dto.ts\" \"*\" -o resources/schemas/data-planes.schema.json",
    "schema:all": "npm run schema:dsp && npm run schema:data-planes"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.5",
    "@nestjs/core": "^10.0.5",
    "@nestjs/platform-express": "^10.0.5",
    "@nestjs/schedule": "^3.0.1",
    "axios": "^1.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "deep-equal": "^2.2.2",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonld": "^8.2.0",
    "nest-typed-config": "^2.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.1.11",
    "@nestjs/testing": "^10.0.5",
    "@types/cron": "^2.0.1",
    "@types/deep-equal": "^1.0.1",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/jest": "^29.5.3",
    "@types/jsonld": "^1.5.9",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "@typescript-eslint/parser": "^5.60.0",
    "eslint": "^8.43.0",
    "jest": "^29.6.1",
    "msw": "^1.2.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.1.3",
    "typescript-json-schema": "^0.59.0"
  }
}
