{
  "name": "tno-security-gateway",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "dev:wallet-ui": "pnpm --filter wallet-ui dev",
    "dev:wallet-api": "pnpm --filter wallet-api dev",
    "dev:control-plane-ui": "pnpm --filter control-plane-ui dev",
    "dev:control-plane-api": "pnpm --filter control-plane-api dev",
    "dev:http-data-plane-ui": "pnpm --filter http-data-plane-ui dev",
    "dev:http-data-plane-api": "pnpm --filter http-data-plane-api dev",
    "dev": "pnpm -r dev",
    "dev:embedded": "pnpm --filter frontend build && CONFIG_PATH=\"./config.yaml\" EMBEDDED_FRONTEND=\"../frontend/dist\" pnpm run --filter backend watch",
    "start:control-plane": "pnpm --filter control-plane-api build && pnpm --filter control-plane-api start",
    "start:http-data-plane": "pnpm --filter http-data-plane-api build && pnpm --filter http-data-plane-api start",
    "start:wallet": "pnpm --filter wallet-api build && pnpm --filter wallet-api start",
    "start:prod": "pnpm --filter backend start",
    "test": "pnpm -r jest",
    "test:coverage": "pnpm -r jest:coverage",
    "test:control-plane-ci": "pnpm --filter control-plane-api jest:ci",
    "test:http-data-plane-ci": "pnpm --filter http-data-plane-api jest:ci",
    "test:wallet-ci": "pnpm --filter wallet-api jest:ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.0.3",
    "@semantic-release/gitlab-config": "^14.0.1",
    "prettier": "^2.8.8",
    "semantic-release": "^24.0.0",
    "semantic-release-monorepo": "^8.0.2"
  }
}
