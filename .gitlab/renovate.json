{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "commitMessagePrefix": "chore: Renovate",
  "commitMessageExtra": "from {{{currentVersion}}} to {{{newVersion}}}",
  "labels": ["Renovate"],
  "prHourlyLimit": 0,
  "branchPrefix": "renovate-",
  "packageRules": [
    {
      "description": "Disable vue-tsc updates due to typescript version mismatch",
      "packagePatterns": ["vue-tsc**"],
      "enabled": false
    }
  ]
}
