{
  "name": "@apps/control-plane-api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "watch": "rimraf control-plane.sqlite && tsc-watch -p tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "start": "node ./dist/app.js",
    "buildAndStart": "tsc -p tsconfig.json && node ./dist/app.js",
    "tsc": "tsc -p tsconfig.json",
    "dev": "pnpm watch",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "lint": "eslint . --fix --ext .ts",
    "swagger": "tsc -p tsconfig.json && node dist/generate-oas.js",
    "jest": "jest",
    "jest:coverage": "jest --coverage --coverage-reporters text",
    "jest:ci": "jest --coverage --coverage-reporters cobertura --coverage-reporters text --ci --reporters=default --reporters=jest-junit",
    "migrations:generate": "npx tsx src/migrations.executor.ts",
    "migrations:check": "npx tsx src/migrations.executor.ts --check"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nestjs/common": "^10.4.11",
    "@nestjs/core": "^10.4.11",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/platform-express": "^10.4.11",
    "@nestjs/platform-socket.io": "^10.4.11",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.4.11",
    "@tsg-dsp/common-api": "workspace:*",
    "@tsg-dsp/common-dsp": "workspace:*",
    "@tsg-dsp/common-dtos": "workspace:*",
    "@tsg-dsp/control-plane-dtos": "workspace:*",
    "@types/jsonpath": "^0.2.4",
    "ajv": "^8.17.1",
    "axios": "^1.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "deep-equal": "^2.2.2",
    "did-resolver": "^4.1.0",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "jose": "^5.9.6",
    "jsonld": "^8.2.0",
    "jsonpath": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "1.4.5-lts.1",
    "nest-typed-config": "^2.7.0",
    "pg": "^8.13.1",
    "qs": "^6.13.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.17",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@jest/types": "^29.6.3",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.11",
    "@types/deep-equal": "^1.0.1",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/jsonld": "^1.5.15",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/qs": "^6.9.17",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "chalk": "^5.0.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "msw": "^2.6.6",
    "pgmock": "^1.0.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.7.2",
    "typescript-json-schema": "^0.65.0"
  }
