{
  "name": "@apps/control-plane-api",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "watch": "rimraf control-plane.sqlite dist && tsc-watch -p tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "start": "node ./dist/app.js",
    "buildAndStart": "rimraf dist && tsc -p tsconfig.json && node ./dist/app.js",
    "tsc": "tsc -p tsconfig.json",
    "dev": "pnpm watch",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "lint": "eslint . --fix --ext .ts",
    "swagger": "tsc -p tsconfig.json && node dist/generate-oas.js",
    "configDocs": "tsc -p tsconfig.json && node dist/generate-config-documentation.js",
    "jest": "jest",
    "jest:coverage": "jest --coverage --coverage-reporters text",
    "jest:ci": "jest --coverage --coverage-reporters cobertura --coverage-reporters text --ci --reporters=default --reporters=jest-junit",
    "migrations:generate": "npx tsx src/migrations.executor.ts",
    "migrations:check": "npx tsx src/migrations.executor.ts --check"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.0.4",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.6",
    "@tsg-dsp/common-api": "workspace:*",
    "@tsg-dsp/common-dsp": "workspace:*",
    "@tsg-dsp/common-dtos": "workspace:*",
    "@tsg-dsp/common-signing-and-validation": "workspace:*",
    "@tsg-dsp/control-plane-dtos": "workspace:*",
    "@types/jsonpath": "^0.2.4",
    "ajv": "^8.17.1",
    "axios": "^1.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "deep-equal": "^2.2.2",
    "did-resolver": "^4.1.0",
    "express": "^5.0.1",
    "express-session": "^1.18.2",
    "jose": "^6.0.12",
    "jsonld": "^8.2.0",
    "jsonpath": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nest-typed-config": "^2.9.4",
    "pg": "^8.16.3",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.25",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@jest/types": "^30.0.5",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/deep-equal": "^1.0.1",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.1",
    "@types/qs": "^6.9.18",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "chalk": "^5.5.0",
    "eslint": "^9.33.0",
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0",
    "msw": "^2.10.4",
    "pgmock": "^1.0.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.0.0",
    "typescript": "^5.9.2",
    "typescript-json-schema": "^0.65.0"
  }
}
