{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Action": {
            "enum": [
                "cc:Attribution",
                "cc:CommericalUse",
                "cc:DerivativeWorks",
                "cc:Distribution",
                "cc:Notice",
                "cc:Reproduction",
                "cc:ShareAlike",
                "cc:Sharing",
                "cc:SourceCode",
                "odrl:acceptTracking",
                "odrl:aggregate",
                "odrl:annotate",
                "odrl:anonymize",
                "odrl:archive",
                "odrl:attribute",
                "odrl:compensate",
                "odrl:concurrentUse",
                "odrl:delete",
                "odrl:derive",
                "odrl:digitize",
                "odrl:display",
                "odrl:distribute",
                "odrl:ensureExclusivity",
                "odrl:execute",
                "odrl:extract",
                "odrl:give",
                "odrl:grantUse",
                "odrl:include",
                "odrl:index",
                "odrl:inform",
                "odrl:install",
                "odrl:modify",
                "odrl:move",
                "odrl:nextPolicy",
                "odrl:obtainConsent",
                "odrl:play",
                "odrl:present",
                "odrl:print",
                "odrl:read",
                "odrl:reproduce",
                "odrl:reviewPolicy",
                "odrl:sell",
                "odrl:stream",
                "odrl:synchronize",
                "odrl:textToSpeech",
                "odrl:transform",
                "odrl:translate",
                "odrl:uninstall",
                "odrl:use",
                "odrl:watermark"
            ],
            "type": "string"
        },
        "LDAgreement": {
            "properties": {
                "@id": {
                    "type": "string"
                },
                "@type": {
                    "const": "odrl:Agreement",
                    "type": "string"
                },
                "dspace:consumerId": {
                    "type": "string"
                },
                "dspace:providerId": {
                    "type": "string"
                },
                "odrl:assignee": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:assigner": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:obligation": {
                    "items": {
                        "$ref": "#/definitions/LDDuty"
                    },
                    "type": "array"
                },
                "odrl:permission": {
                    "items": {
                        "$ref": "#/definitions/LDPermission"
                    },
                    "type": "array"
                },
                "odrl:profile": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:prohibition": {
                    "items": {
                        "$ref": "#/definitions/LDProhibition"
                    },
                    "type": "array"
                },
                "odrl:timestamp": {
                    "$ref": "#/definitions/LDTime"
                }
            },
            "type": "object"
        },
        "LDConstraint": {
            "properties": {
                "@type": {
                    "const": "odrl:Constraint",
                    "type": "string"
                },
                "odrl:leftOperand": {
                    "$ref": "#/definitions/LeftOperand"
                },
                "odrl:operator": {
                    "$ref": "#/definitions/Operator"
                },
                "odrl:rightOperand": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/LDReference"
                        },
                        {
                            "$ref": "#/definitions/LDMultilanguage"
                        },
                        {
                            "$ref": "#/definitions/LDTime"
                        },
                        {
                            "$ref": "#/definitions/LDDecimal"
                        },
                        {
                            "$ref": "#/definitions/LDDuration"
                        },
                        {
                            "$ref": "#/definitions/LDURI"
                        }
                    ]
                },
                "odrl:rightOperandReference": {
                    "$ref": "#/definitions/LDReference"
                }
            },
            "type": "object"
        },
        "LDContractAgreementMessage": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractAgreementMessage",
                    "type": "string"
                },
                "dspace:agreement": {
                    "$ref": "#/definitions/LDAgreement"
                },
                "dspace:processId": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDContractAgreementVerificationMessage": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractAgreementVerificationMessage",
                    "type": "string"
                },
                "cred:credentialSubject": {
                    "additionalProperties": {},
                    "properties": {
                        "dspace:hash": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "dspace:processId": {
                    "type": "string"
                },
                "sec:proof": {
                    "$ref": "#/definitions/LDProof"
                }
            },
            "type": "object"
        },
        "LDContractNegotiation": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractNegotiation",
                    "type": "string"
                },
                "dspace:negotiationId": {
                    "type": "string"
                },
                "dspace:processId": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDContractNegotiationError": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractNegotiationError",
                    "type": "string"
                },
                "dct:description": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "dspace:processId": {
                    "type": "string"
                },
                "dspace:reason": {
                    "items": {
                        "$ref": "#/definitions/LDMultilanguage"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "LDContractNegotiationEventMessage": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractNegotiationEventMessage",
                    "type": "string"
                },
                "dspace:eventType": {
                    "$ref": "#/definitions/NegotiationEvent"
                },
                "dspace:processId": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDContractNegotiationTerminationMessage": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractNegotiationTerminationMessage",
                    "type": "string"
                },
                "dspace:code": {
                    "type": "string"
                },
                "dspace:processId": {
                    "type": "string"
                },
                "dspace:reason": {
                    "items": {
                        "$ref": "#/definitions/LDMultilanguage"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "LDContractOfferMessage": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractOfferMessage",
                    "type": "string"
                },
                "dspace:callbackAddress": {
                    "type": "string"
                },
                "dspace:processId": {
                    "type": "string"
                },
                "odrl:offer": {
                    "$ref": "#/definitions/LDOffer"
                }
            },
            "type": "object"
        },
        "LDContractRequestMessage": {
            "properties": {
                "@type": {
                    "const": "dspace:ContractRequestMessage",
                    "type": "string"
                },
                "dspace:callbackAddress": {
                    "type": "string"
                },
                "dspace:processId": {
                    "type": "string"
                },
                "odrl:offer": {
                    "$ref": "#/definitions/LDOffer"
                }
            },
            "type": "object"
        },
        "LDDecimal": {
            "properties": {
                "@type": {
                    "const": "xsd:decimal",
                    "type": "string"
                },
                "@value": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDDuration": {
            "properties": {
                "@type": {
                    "const": "xsd:duration",
                    "type": "string"
                },
                "@value": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDDuty": {
            "properties": {
                "@type": {
                    "const": "odrl:Duty",
                    "type": "string"
                },
                "odrl:action": {
                    "$ref": "#/definitions/Action"
                },
                "odrl:assignee": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:assigner": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:constraint": {
                    "items": {
                        "$ref": "#/definitions/LDConstraint"
                    },
                    "type": "array"
                },
                "odrl:target": {
                    "$ref": "#/definitions/LDReference"
                }
            },
            "type": "object"
        },
        "LDMultilanguage": {
            "properties": {
                "@language": {
                    "type": "string"
                },
                "@value": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDOffer": {
            "properties": {
                "@id": {
                    "type": "string"
                },
                "@type": {
                    "const": "odrl:Offer",
                    "type": "string"
                },
                "odrl:assignee": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:assigner": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:obligation": {
                    "items": {
                        "$ref": "#/definitions/LDDuty"
                    },
                    "type": "array"
                },
                "odrl:permission": {
                    "items": {
                        "$ref": "#/definitions/LDPermission"
                    },
                    "type": "array"
                },
                "odrl:profile": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:prohibition": {
                    "items": {
                        "$ref": "#/definitions/LDProhibition"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "LDPermission": {
            "properties": {
                "@type": {
                    "const": "odrl:Permission",
                    "type": "string"
                },
                "odrl:action": {
                    "$ref": "#/definitions/Action"
                },
                "odrl:assignee": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:assigner": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:constraint": {
                    "items": {
                        "$ref": "#/definitions/LDConstraint"
                    },
                    "type": "array"
                },
                "odrl:duty": {
                    "items": {
                        "$ref": "#/definitions/LDDuty"
                    },
                    "type": "array"
                },
                "odrl:target": {
                    "$ref": "#/definitions/LDReference"
                }
            },
            "type": "object"
        },
        "LDProhibition": {
            "properties": {
                "@type": {
                    "const": "odrl:Prohibition",
                    "type": "string"
                },
                "odrl:action": {
                    "$ref": "#/definitions/Action"
                },
                "odrl:assignee": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:assigner": {
                    "$ref": "#/definitions/LDReference"
                },
                "odrl:constraint": {
                    "items": {
                        "$ref": "#/definitions/LDConstraint"
                    },
                    "type": "array"
                },
                "odrl:target": {
                    "$ref": "#/definitions/LDReference"
                }
            },
            "type": "object"
        },
        "LDProof": {
            "additionalProperties": {},
            "properties": {
                "@type": {
                    "$ref": "#/definitions/ProofTypes"
                },
                "dct:created": {
                    "$ref": "#/definitions/LDTime"
                },
                "sec:jws": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDReference": {
            "properties": {
                "@id": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDTime": {
            "properties": {
                "@type": {
                    "const": "xsd:dateTime",
                    "type": "string"
                },
                "@value": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LDURI": {
            "properties": {
                "@type": {
                    "const": "xsd:anyURI",
                    "type": "string"
                },
                "@value": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LeftOperand": {
            "enum": [
                "odrl:absolutePosition",
                "odrl:absoluteSize",
                "odrl:absoluteSpatialPosition",
                "odrl:absoluteTemporalPosition",
                "odrl:count",
                "odrl:dateTime",
                "odrl:delayPeriod",
                "odrl:deliveryChannel",
                "odrl:device",
                "odrl:elapsedTime",
                "odrl:event",
                "odrl:fileFormat",
                "odrl:industry",
                "odrl:language",
                "odrl:media",
                "odrl:meteredTime",
                "odrl:payAmount",
                "odrl:percentage",
                "odrl:product",
                "odrl:purpose",
                "odrl:recipient",
                "odrl:relativePosition",
                "odrl:relativeSize",
                "odrl:relativeSpatialPosition",
                "odrl:relativeTemporalPosition",
                "odrl:resolution",
                "odrl:spatial",
                "odrl:spatialCoordinates",
                "odrl:system",
                "odrl:systemDevice",
                "odrl:timeInterval",
                "odrl:unitOfCount",
                "odrl:version",
                "odrl:virtualLocation"
            ],
            "type": "string"
        },
        "NegotiationEvent": {
            "enum": [
                "dspace:ACCEPTED",
                "dspace:FINALIZED"
            ],
            "type": "string"
        },
        "Operator": {
            "enum": [
                "odrl:eq",
                "odrl:gt",
                "odrl:gteq",
                "odrl:hasPart",
                "odrl:isA",
                "odrl:isAllOf",
                "odrl:isAnyOf",
                "odrl:isNoneOf",
                "odrl:isPartOf",
                "odrl:lt",
                "odrl:neq",
                "odrl:term-lteq"
            ],
            "type": "string"
        },
        "ProofTypes": {
            "enum": [
                "sec:BbsBlsSignature2020",
                "sec:BbsBlsSignatureProof2020",
                "sec:EcdsaSecp256k1RecoverySignature2020",
                "sec:EcdsaSecp256k1Signature2019",
                "sec:Ed25519Signature2020",
                "sec:JsonWebSignature2020",
                "sec:MerkleProof2019",
                "sec:RsaSignature2018",
                "sec:SchnorrSecp256k1Signature2019"
            ],
            "type": "string"
        }
    }
}

