    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "did-resolver": "^4.1.0",
    "express-session": "^1.19.0",
    "jose": "^6.2.1",
    "jsonpath": "^1.3.0",
    "multer": "^2.1.1",
