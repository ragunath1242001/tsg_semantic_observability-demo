{
  "name": "@apps/http-data-plane-api",
  "version": "0.19.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "watch": "rimraf test.db dist && tsc-watch -p tsconfig.build.json --onSuccess \"node ./dist/app.js\"",
    "start": "node ./dist/app.js",
    "buildAndStart": "rimraf dist && tsc -p tsconfig.build.json && node ./dist/app.js",
    "dev": "pnpm watch",
    "tsc": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "eslint . --fix --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "swagger": "tsc -p tsconfig.json && node dist/generate-oas.js",
    "configDocs": "tsc -p tsconfig.json && node dist/generate-config-documentation.js",
    "migrations:generate": "pnpm exec tsx src/migrations.executor.ts",
    "migrations:check": "pnpm exec tsx src/migrations.executor.ts --check"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
