{
  "name": "@apps/analytics-data-plane-api",
  "version": "0.13.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "watch": "rimraf dist && tsc-watch -p tsconfig.build.json --onSuccess \"node ./dist/app.js\"",
    "start": "node ./dist/app.js",
    "buildAndStart": "rimraf dist && tsc -p tsconfig.build.json && node ./dist/app.js",
    "dev": "pnpm watch",
    "tsc": "tsc -p tsconfig.build.json",
    "lint": "eslint . --fix --ext .ts",
    "swagger": "tsc -p tsconfig.json && node dist/generate-oas.js",
    "configDocs": "tsc -p tsconfig.json && node dist/generate-config-documentation.js",
    "jest": "jest",
    "jest:coverage": "jest --coverage --coverage-reporters text",
    "jest:ci": "jest --coverage --coverage-reporters cobertura --coverage-reporters text --ci --reporters=default --reporters=jest-junit",
    "migrations:generate-sqlite": "npx tsx src/migrations.executor.ts --sqlite",
    "migrations:generate-postgres": "npx tsx src/migrations.executor.ts --postgres",
    "migrations:generate": "pnpm migrations:generate-sqlite && pnpm migrations:generate-postgres",
    "migrations:check": "npx tsx src/migrations.executor.ts --check"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.0.4",
    "@nestjs/typeorm": "^11.0.0",
    "@tsg-dsp/analytics-data-plane-dtos": "workspace:*",
    "@tsg-dsp/common-api": "workspace:*",
    "@tsg-dsp/common-dsp": "workspace:*",
    "@tsg-dsp/common-dtos": "workspace:*",
    "@tsg-dsp/common-signing-and-validation": "workspace:*",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "csv-parse": "^6.1.0",
    "did-resolver": "^4.1.0",
    "express": "^5.0.1",
    "express-session": "^1.18.2",
    "jose": "^6.0.12",
    "jsonld": "^8.2.1",
    "jsonpath": "^1.1.1",
    "multer": "^2.0.2",
    "nest-typed-config": "^2.9.4",
    "pg": "^8.16.3",
    "raw-body": "^3.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.25",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@jest-mock/express": "^3.0.0",
    "@jest/globals": "^30.0.5",
    "@jest/types": "^30.0.5",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/jsonpath": "^0.2.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "chalk": "^5.5.0",
    "eslint": "^9.33.0",
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0",
    "msw": "^2.10.4",
    "pgmock": "^1.0.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "tsc-watch": "^7.0.0",
    "typescript": "^5.9.2"
  }
