{
  "name": "@apps/analytics-data-plane-api",
  "version": "0.17.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "watch": "rimraf dist && tsc-watch -p tsconfig.build.json --onSuccess \"node ./dist/app.js\"",
    "start": "node ./dist/app.js",
    "buildAndStart": "rimraf dist && tsc -p tsconfig.build.json && node ./dist/app.js",
    "dev": "pnpm watch",
    "tsc": "tsc -p tsconfig.build.json",
    "lint": "eslint . --fix --ext .ts",
    "swagger": "tsc -p tsconfig.json && node dist/generate-oas.js",
    "configDocs": "tsc -p tsconfig.json && node dist/generate-config-documentation.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "migrations:generate-sqlite": "npx tsx src/migrations.executor.ts --sqlite",
    "migrations:generate-postgres": "npx tsx src/migrations.executor.ts --postgres",
    "migrations:generate": "pnpm migrations:generate-sqlite && pnpm migrations:generate-postgres",
    "migrations:check": "npx tsx src/migrations.executor.ts --check"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
