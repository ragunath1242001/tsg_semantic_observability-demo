{
  "name": "@apps/wallet-api",
  "version": "0.7.0",
  "description": "TSG Dataspace Protocol SSI Wallet",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc-watch -p tsconfig.build.json --onSuccess \"node ./dist/app.js\"",
    "start": "node ./dist/app.js",
    "buildAndStart": "tsc -p tsconfig.build.json && node ./dist/app.js",
    "dev": "pnpm watch",
    "tsc": "tsc -p tsconfig.build.json",
    "lint": "eslint . --fix --ext .ts",
    "swagger": "tsc -p tsconfig.build.json && node dist/generate-oas.js",
    "configDocs": "tsc -p tsconfig.build.json && node dist/generate-config-documentation.js",
    "jest": "jest",
    "jest:coverage": "jest --coverage --coverage-reporters text",
    "jest:ci": "jest --coverage --coverage-reporters cobertura --coverage-reporters text --ci --reporters=default --reporters=jest-junit",
    "migrations:generate": "npx tsx src/migrations.executor.ts",
    "migrations:check": "npx tsx src/migrations.executor.ts --check"
  },
  "files": [
    "dist"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@digitalbazaar/bitstring": "^3.1.0",
    "@nestjs/common": "^10.4.11",
    "@nestjs/core": "^10.4.11",
    "@nestjs/platform-express": "^10.4.11",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/typeorm": "^10.0.1",
    "@tsg-dsp/common-api": "workspace:*",
    "@tsg-dsp/common-dsp": "workspace:*",
    "@tsg-dsp/common-dtos": "workspace:*",
    "@tsg-dsp/wallet-dtos": "workspace:*",
    "@tufjs/canonical-json": "^2.0.0",
    "@types/varint": "^6.0.3",
    "ajv": "^8.17.1",
    "axios": "^1.7.8",
    "bignumber.js": "^9.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-resolver": "^4.1.0",
    "elliptic": "^6.6.1",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "fast-json-patch": "^3.1.1",
    "jose": "^5.9.6",
    "json-canonicalize": "^1.0.6",
    "jsonld": "^8.3.2",
    "jsonpath": "^1.1.1",
    "multer": "1.4.5-lts.1",
    "multiformats": "^13.3.1",
    "nest-typed-config": "^2.9.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.17",
    "varint": "^6.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@jest/types": "^29.6.3",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.11",
    "@types/digitalbazaar__bitstring": "^3.1.1",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/jsonld": "^1.5.15",
    "@types/jsonpath": "^0.2.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "chalk": "^5.0.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "msw": "^2.6.6",
    "pgmock": "^1.0.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "msw": {
      "typescript": "$typescript"
    }
  }
}
