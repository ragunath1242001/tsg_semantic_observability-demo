{
  "name": "@apps/wallet-api",
  "version": "0.14.1",
  "private": true,
  "description": "TSG Dataspace Protocol SSI Wallet",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "watch": "rimraf dist && tsc-watch -p tsconfig.build.json --onSuccess \"node ./dist/app.js\"",
    "start": "node ./dist/app.js",
    "buildAndStart": "rimraf dist && tsc -p tsconfig.build.json && node ./dist/app.js",
    "dev": "pnpm watch",
    "tsc": "tsc -p tsconfig.build.json",
    "lint": "eslint . --fix --ext .ts",
    "swagger": "tsc -p tsconfig.build.json && node dist/generate-oas.js",
    "configDocs": "tsc -p tsconfig.build.json && node dist/generate-config-documentation.js",
    "jest": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "jest:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --coverage-reporters text",
    "jest:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --coverage-reporters cobertura --coverage-reporters text --ci --reporters=default --reporters=jest-junit",
    "migrations:generate": "npx tsx src/migrations.executor.ts",
    "migrations:check": "npx tsx src/migrations.executor.ts --check"
  },
  "files": [
    "dist"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@digitalbazaar/bitstring": "^3.1.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@tsg-dsp/common-api": "workspace:*",
    "@tsg-dsp/common-dsp": "workspace:*",
    "@tsg-dsp/common-dtos": "workspace:*",
    "@tsg-dsp/common-signing-and-validation": "workspace:*",
    "@tsg-dsp/wallet-dtos": "workspace:*",
    "@tufjs/canonical-json": "^2.0.0",
    "@types/varint": "^6.0.3",
    "ajv": "^8.17.1",
    "axios": "^1.13.2",
    "bignumber.js": "^9.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "did-resolver": "^4.1.0",
    "elliptic": "^6.6.1",
    "express": "^5.0.1",
    "express-session": "^1.18.2",
    "fast-json-patch": "^3.1.1",
    "jose": "^6.1.2",
    "json-canonicalize": "^2.0.0",
    "jsonld": "^9.0.0",
    "jsonpath": "^1.1.1",
    "multer": "^2.0.2",
    "multiformats": "^13.4.0",
    "nest-typed-config": "^2.9.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.25",
    "varint": "^6.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@jest/types": "^30.0.5",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/testing": "^11.1.9",
    "@types/digitalbazaar__bitstring": "^3.1.1",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/jsonpath": "^0.2.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "chalk": "^5.5.0",
    "eslint": "^9.39.1",
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0",
    "msw": "^2.12.3",
    "pgmock": "^1.0.3",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "msw": {
      "typescript": "$typescript"
    }
  }
}
