{
  "compilerOptions": {
    "paths": {},
    "module": "CommonJS",
    "declaration": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "importHelpers": true,
    "removeComments": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "target": "ES2016",
    "sourceMap": true,
    "declarationMap": true,
    "allowJs": false,
    "strict": true,
    "strictNullChecks": false,
    "types": [],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["."],
  "exclude": ["dist"]
}
