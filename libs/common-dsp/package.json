{
  "name": "@tsg-dsp/common-dsp",
  "version": "0.18.0",
  "description": "TSG Dataspace Protocol Common",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/tno-tsg/dataspace-protocol/tno-security-gateway.git",
    "directory": "libs/common-dsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "prepare": "install-peers",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.mjs",
