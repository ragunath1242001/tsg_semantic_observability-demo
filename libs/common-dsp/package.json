{
  "name": "@tsg-dsp/common-dsp",
  "version": "0.13.0",
  "description": "TSG Dataspace Protocol Common",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/tno-tsg/dataspace-protocol/tno-security-gateway.git",
    "directory": "libs/common-dsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "prepare": "install-peers",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "copyfiles -f src/jsonld/contexts/{tsg,health}.json ../../website/docs",
    "jest": "jest",
    "jest:coverage": "jest --coverage --coverage-reporters text",
    "jest:ci": "jest --coverage --coverage-reporters cobertura --coverage-reporters text --ci --reporters=default --reporters=jest-junit"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "*.md"
  ],
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "class-validator": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@jest/types": "^30.0.5",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^22.17.1",
    "copyfiles": "^2.4.1",
    "install-peers-cli": "^2.2.0",
    "jest": "^30.0.5",
    "msw": "^2.10.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "flat-cache": "^6.1.12",
    "jsonld": "^8.3.2",
    "uuid": "^11.1.0"
  }
}
