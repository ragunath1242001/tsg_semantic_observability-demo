    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "class-validator": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.0.17",
    "install-peers-cli": "^2.2.0",
    "msw": "^2.12.10",
    "ts-node": "^10.9.2",
