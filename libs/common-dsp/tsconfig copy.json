{
  "compilerOptions": {
    "outDir": "dist",
    "paths": {},
    "module": "commonjs",
    "declaration": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "importHelpers": true,
    "removeComments": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "target": "ES2016",
    "sourceMap": true,
    "declarationMap": true,
    "allowJs": false,
    "strict": true,
    "strictNullChecks": false,
    "types": ["node"]
  },
  "exclude": ["jest.config.ts", "tsup.config.ts", "dist"]
}
