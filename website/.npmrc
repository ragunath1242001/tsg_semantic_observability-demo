# Supply Chain Security Settings for npm
# See: https://docs.npmjs.com/cli/v11/using-npm/config

# =============================================================================
# SECURITY
# =============================================================================

# Enforce HTTPS and explicit registry
strict-ssl=true
registry=https://registry.npmjs.org/

# Pin exact versions when adding new dependencies
save-exact=true

# Run security audit after install
audit=true
audit-level=moderate

# Block all postinstall scripts by default
ignore-scripts=true

# =============================================================================
# NOISE REDUCTION
# =============================================================================

fund=false
update-notifier=false
loglevel=warn

# =============================================================================
# COMPATIBILITY
# =============================================================================

# Required for React 19 with packages that haven't updated peer deps yet
legacy-peer-deps=true
