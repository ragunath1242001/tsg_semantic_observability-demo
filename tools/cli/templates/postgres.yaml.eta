auth:
  username: postgres
  password: password

primary:
  persistence:
    size: 1Gi
  # For test deployments, delete the PVC when the helm release is removed
  persistentVolumeClaimRetentionPolicy:
    enabled: true
    whenScaled: Delete
    whenDeleted: Delete
  initdb:
    scripts:
      create-dbs.sql: |-
        CREATE DATABASE "sso-bridge";
        GRANT ALL PRIVILEGES ON DATABASE "sso-bridge" TO postgres;
        CREATE DATABASE wallet;
        GRANT ALL PRIVILEGES ON DATABASE wallet TO postgres;
        CREATE DATABASE "control-plane";
        GRANT ALL PRIVILEGES ON DATABASE "control-plane" TO postgres;
<%- it.participant.dataPlanes.forEach((value, id) => { %>
        CREATE DATABASE "<%= id %>";
        GRANT ALL PRIVILEGES ON DATABASE "<%= id %>" TO postgres;
<%- }); %>
