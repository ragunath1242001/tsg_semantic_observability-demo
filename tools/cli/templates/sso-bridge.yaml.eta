<% if (it.participant.routing === "subdomain") { %>
host: "sso-bridge.<%= it.participant.host %>"
<% } else { %>
host: "<%= it.participant.host %>"
<% } %>

<% if (it.applications?.ssoBridge?.imageTag || it.applications?.ssoBridge?.imageRepository) { %>
image:
<%- if (it.applications?.ssoBridge?.imageTag) { %>
  tag: <%= it.applications?.ssoBridge.imageTag %>
<% } %>
<%- if (it.applications?.ssoBridge?.imageRepository) { %>
  repository: <%= it.applications?.ssoBridge.imageRepository %>
<% } %>
<% } %>

ingress:
  enabled: true

<%
const postgresMode = it.general.postgresDeploymentMode ?? "per-participant";
const isShared = postgresMode === "per-namespace" && it.scope === "ecosystem";
let secretName, dbHost, dbName;

if (isShared) {
  secretName = "postgresql-cluster-app";
  dbHost = "postgresql-cluster-rw";
  dbName = `${it.participant.id}-sso-bridge`; // Prefixed for shared cluster
} else {
  secretName = `${it.participant.id}-postgresql-app`;
  dbHost = `${it.participant.id}-postgresql-rw`;
  dbName = "sso-bridge"; // No prefix for dedicated cluster
}
%>

configFromSecrets:
  db:
    password:
      name: "<%= secretName %>"
      key: password

config:
  db:
    database: <%= dbName %>
    host: "<%= dbHost %>"
    username: app
  kubernetesNamespace: <%= it.general.namespace %>
  initRoles:
    - name: "ssobridge_admin"
      description: "SSO bridge administrator role with full access"
      isAdminRole: true
    - name: "ssobridge_user"
      description: "SSO bridge regular user role with limited access"
    - name: wallet_view_did
      description: View DID
    - name: wallet_manage_keys
      description: Manage keys
    - name: wallet_use_keys
      description: Use keys
    - name: wallet_view_own_credentials
      description: View own credentials
    - name: wallet_view_all_credentials
      description: View all credentials
    - name: wallet_manage_own_credentials
      description: Manage own credentials
    - name: wallet_manage_all_credentials
      description: Manage all credentials
    - name: wallet_issue_credentials
      description: Issue credentials
    - name: wallet_view_presentations
      description: View presentations
    - name: wallet_manage_clients
      description: Manage clients
    - name: controlplane_admin
      description: Control Plane Admin role
      isAdminRole: true
    - name: controlplane_dataplane
      description: Control Plane Data Plane role
  initUsers:
    - username: <%= it.general.username %>
      password: <%= it.general.password %>
      email: <%= it.general.username %>@example.com
      roles:
        - ssobridge_admin
        - ssobridge_user
        - wallet_view_did
        - wallet_manage_keys
        - wallet_use_keys
        - wallet_view_own_credentials
        - wallet_view_all_credentials
        - wallet_manage_own_credentials
        - wallet_manage_all_credentials
        - wallet_issue_credentials
        - wallet_view_presentations
        - wallet_manage_clients
        - controlplane_admin
        - controlplane_dataplane
  initClients:
    - clientId: wallet
      clientSecret: wallet
      name: <%= it.participant.name %> Wallet
      description: <%= it.participant.name %> Wallet
      secretName: sso-<%= it.participant.id %>-wallet-secret
      redirectUris:
        - https://.*<%= it.participant.host %>/.*
      roles:
        - wallet_view_did
        - wallet_manage_keys
        - wallet_use_keys
        - wallet_view_own_credentials
        - wallet_view_all_credentials
        - wallet_manage_own_credentials
        - wallet_manage_all_credentials
        - wallet_issue_credentials
        - wallet_view_presentations
        - wallet_manage_clients
    - clientId: control-plane
      clientSecret: control-plane
      name: <%= it.participant.name %> Control Plane
      description: <%= it.participant.name %> Control Plane
      secretName: sso-<%= it.participant.id %>-control-plane-secret
      redirectUris:
        - https://.*<%= it.participant.host %>/.*
      roles:
        - wallet_view_did
        - wallet_issue_credentials
        - wallet_use_keys
        - wallet_view_all_credentials
        - wallet_view_presentations
        - controlplane_admin
        - controlplane_dataplane
<%- it.participant.dataPlanes.forEach((value, id) => { %>
    - clientId: <%= id %>
      clientSecret: <%= id %>
      name: <%= it.participant.name %> Data Plane <%= id %>
      description: <%= it.participant.name %> Data Plane <%= id %>
      secretName: sso-<%= it.participant.id %>-<%= id %>-secret
      redirectUris:
        - https://.*<%= it.participant.host %>/.*
      roles:
        - controlplane_dataplane
<%- }); %>
