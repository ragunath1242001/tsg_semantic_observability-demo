<% if (it.participant.routing === "subdomain") { %>
host: "sso-bridge.<%= it.participant.host %>"
<% } else { %>
host: "<%= it.participant.host %>"
<% } %>

<% if (it.applications?.ssoBridge?.imageTag || it.applications?.ssoBridge?.imageRepository) { %>
image:
<%- if (it.applications?.ssoBridge?.imageTag) { %>
  tag: <%= it.applications?.ssoBridge.imageTag %>
<% } %>
<%- if (it.applications?.ssoBridge?.imageRepository) { %>
  repository: <%= it.applications?.ssoBridge.imageRepository %>
<% } %>
<% } %>

ingress:
  enabled: true

<%
const postgresMode = it.general.postgresDeploymentMode ?? "per-participant";
const isShared = postgresMode === "per-namespace" && it.scope === "ecosystem";
let secretName, dbHost, dbName;

if (isShared) {
  secretName = "postgresql-cluster-app";
  dbHost = "postgresql-cluster-rw";
  dbName = `${it.participant.id}-sso-bridge`; // Prefixed for shared cluster
} else {
  secretName = `${it.participant.id}-postgresql-app`;
  dbHost = `${it.participant.id}-postgresql-rw`;
  dbName = "sso-bridge"; // No prefix for dedicated cluster
}
%>

configFromSecrets:
  db:
    password:
      name: "<%= secretName %>"
      key: password

config:
  db:
    database: <%= dbName %>
    host: "<%= dbHost %>"
    username: app
  kubernetesNamespace: <%= it.general.namespace %>
  initUsers:
    - username: <%= it.general.username %>
      password: <%= it.general.password %>
      email: <%= it.general.username %>@example.com
      require2FA: <%= it.general.require2FA %>
      permissions:
        - manage:sso.*
        - manage:w.*
        - manage:cp.*
        - manage:dp.*
        - manage:adp.*
        - manage:hdp.*
  initClients:
    - clientId: wallet
<% if (it.general.oauthClientAuthMethod === "client_secret_post") { %>
      clientSecret: wallet
<% } %>
      name: <%= it.participant.name %> Wallet
      description: <%= it.participant.name %> Wallet
      secretName: sso-<%= it.participant.id %>-wallet-secret
      tokenEndpointAuthMethod: <%= it.general.oauthClientAuthMethod %>
<% if (it.general.oauthClientAuthMethod === "private_key_jwt" && it.oauthPublicKeys?.wallet) { %>
      jwk: <%= JSON.stringify(it.oauthPublicKeys.wallet) %>
<% } %>
      redirectUris:
        - https://.*<%= it.participant.host %>/.*
      permissions:
        - execute:sso.config
<% if (it.participant.hasControlPlane) { %>
    - clientId: control-plane
<% if (it.general.oauthClientAuthMethod === "client_secret_post") { %>
      clientSecret: control-plane
<% } %>
      name: <%= it.participant.name %> Control Plane
      description: <%= it.participant.name %> Control Plane
      secretName: sso-<%= it.participant.id %>-control-plane-secret
      tokenEndpointAuthMethod: <%= it.general.oauthClientAuthMethod %>
<% if (it.general.oauthClientAuthMethod === "private_key_jwt" && it.oauthPublicKeys?.["control-plane"]) { %>
      jwk: <%= JSON.stringify(it.oauthPublicKeys["control-plane"]) %>
<% } %>
      redirectUris:
        - https://.*<%= it.participant.host %>/.*
      permissions:
        - execute:sso.config
        - read:w.did
        - manage:w.issue_config
        - execute:w.key
        - read:w.credential
        - read:w.presentation
        - manage:dp.*
<% } %>
<%- it.participant.dataPlanes.forEach((value, id) => { 
  const dataPlaneType = value.type ?? id;
  const isAnalytics = dataPlaneType.includes('analytics');
  const resourcePrefix = isAnalytics ? 'adp' : 'hdp';
%>
    - clientId: <%= id %>
<% if (it.general.oauthClientAuthMethod === "client_secret_post") { %>
      clientSecret: <%= id %>
<% } %>
      name: <%= it.participant.name %> Data Plane <%= id %>
      description: <%= it.participant.name %> Data Plane <%= id %>
      secretName: sso-<%= it.participant.id %>-<%= id %>-secret
      tokenEndpointAuthMethod: <%= it.general.oauthClientAuthMethod %>
<% if (it.general.oauthClientAuthMethod === "private_key_jwt" && it.oauthPublicKeys?.[id]) { %>
      jwk: <%= JSON.stringify(it.oauthPublicKeys[id]) %>
<% } %>
      redirectUris:
        - https://.*<%= it.participant.host %>/.*
      permissions:
        - execute:sso.config
        - manage:cp.dataplane
        - manage:cp.catalog
        - manage:cp.dataset
        - manage:cp.negotiation
        - manage:cp.registry
        - manage:cp.transfer
        - read:cp.agreement
        - read:cp.policy
<% if (isAnalytics) { %>
        - execute:w.key
        - create:w.credential
        - manage:adp.dataplane
<% } else { %>
        - manage:hdp.dataplane
<% } %>
<%- }); %>
