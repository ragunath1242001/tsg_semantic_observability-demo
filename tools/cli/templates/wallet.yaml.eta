host: "<%= it.participant.host %>"
<% if (it.participant.routing === "subdomain") { %>
endpoint: https://<%= it.participant.host %>
ssoBridgeEndpoint: "https://sso-bridge.<%= it.participant.host %>"
  <% if (it.participant.hasControlPlane) { %>
controlPlaneEndpoint: https://cp.<%= it.participant.host %>/api
  <% } %>
<% } else { %>
endpoint: https://<%= it.participant.host %>/wallet
ssoBridgeEndpoint: "https://<%= it.participant.host %>"
  <% if (it.participant.hasControlPlane) { %>
controlPlaneEndpoint: https://<%= it.participant.host %>/control-plane/api
  <% } %>
subPath: /wallet
<% } %>

<% if (it.applications?.wallet?.imageTag || it.applications?.wallet?.imageRepository) { %>
image:
<%- if (it.applications?.wallet?.imageTag) { %>
  tag: <%= it.applications?.wallet.imageTag %>
<% } %>
<%- if (it.applications?.wallet?.imageRepository) { %>
  repository: <%= it.applications?.wallet.imageRepository %>
<% } %>
<% } %>

ingress:
  enabled: true

<%
const postgresMode = it.general.postgresDeploymentMode ?? "per-participant";
const isShared = postgresMode === "per-namespace" && it.scope === "ecosystem";
let secretName, dbHost, dbName;

if (isShared) {
  secretName = "postgresql-cluster-app";
  dbHost = "postgresql-cluster-rw";
  dbName = `${it.participant.id}-wallet`; // Prefixed for shared cluster
} else {
  secretName = `${it.participant.id}-postgresql-app`;
  dbHost = `${it.participant.id}-postgresql-rw`;
  dbName = "wallet"; // No prefix for dedicated cluster
}
%>

configFromSecrets:
  db:
    password:
      name: "<%= secretName %>"
      key: password
  auth:
    clientID:
      name: sso-<%= it.participant.id %>-wallet-secret
      key: clientId
    clientSecret:
      name: sso-<%= it.participant.id %>-wallet-secret
      key: clientSecret

config:
  db:
    database: <%= dbName %>
    host: "<%= dbHost %>"
    username: app
  
  server:
    publicAddress: "{{ .Values.endpoint }}"

  auth:
    openIdConfigurationURL: "{{ .Values.ssoBridgeEndpoint }}/.well-known/openid-configuration"
    callbackURL: "{{ .Values.endpoint }}/api/auth/callback"
    redirectURL: "{{ .Values.endpoint }}/"
  
  runtime:
    title: "<%= it.participant.name %>"
  
  initKeys:
    - id: key-0
      type: EdDSA
      default: true
  
  trustAnchors:
    - identifier: did:web:<%= it.general.authorityDomain %>
      credentialTypes:
        - "<%= it.general.credentialType %>"
        - "<%= it.participant.id %>:<%= it.general.credentialType %>"
        - https://<%= it.general.authorityDomain %>/credentials/<%= it.general.credentialType %>
  
<%- if (it.participant.issuer) { %>
  issuance:
    issuer: 
<%- it.participants.filter((p) => !p.issuer).forEach((participant) => { %>
      - holderId: did:web:<%= participant.host %>
        credentialType: <%= it.general.credentialType %>
        credentialSubject: <%= JSON.stringify({...participant.credentialSubject, id: `did:web:${participant.host}`}) %>
        preAuthorizedCode: <%= participant.preAuthorizedCode %>
<% }) %>
<% } else { %>
  issuance:
    dcp:
      - issuerId: did:web:<%= it.general.authorityDomain %>
        preAuthorizedCode: <%= it.participant.preAuthorizedCode %>
        credentialType:
          - <%= it.general.credentialType %>
<% } %>
<%- if (it.participant.hasControlPlane) { %>
  didServices:
    - id: did:web:<%= it.participant.host%>#control-plane
      type: connector
      serviceEndpoint: "{{ .Values.controlPlaneEndpoint }}"
<% } %>
