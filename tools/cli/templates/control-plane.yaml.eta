<% if (it.participant.routing === "subdomain") { %>
host: "cp.<%= it.participant.host %>"
endpoint: https://cp.<%= it.participant.host %>
wallet: "<%= it.participant.host %>"
walletEndpoint: https://<%= it.participant.host %>/api
ssoBridgeEndpoint: "https://sso-bridge.<%= it.participant.host %>"
<% } else { %>
host: "<%= it.participant.host %>"
endpoint: https://<%= it.participant.host %>/control-plane
wallet: "<%= it.participant.host %>"
walletEndpoint: https://<%= it.participant.host %>/wallet/api
ssoBridgeEndpoint: "https://<%= it.participant.host %>"

subPath: /control-plane
<% } %>

<% if (it.applications?.controlPlane?.imageTag || it.applications?.controlPlane?.imageRepository) { %>
image:
<%- if (it.applications?.controlPlane?.imageTag) { %>
  tag: <%= it.applications?.controlPlane.imageTag %>
<% } %>
<%- if (it.applications?.controlPlane?.imageRepository) { %>
  repository: <%= it.applications?.controlPlane.imageRepository %>
<% } %>
<% } %>

ingress:
  enabled: true

<%
const postgresMode = it.general.postgresDeploymentMode ?? "per-participant";
const isShared = postgresMode === "per-namespace" && it.scope === "ecosystem";
let secretName, dbHost, dbName;

if (isShared) {
  secretName = "postgresql-cluster-app";
  dbHost = "postgresql-cluster-rw";
  dbName = `${it.participant.id}-control-plane`; // Prefixed for shared cluster
} else {
  secretName = `${it.participant.id}-postgresql-app`;
  dbHost = `${it.participant.id}-postgresql-rw`;
  dbName = "control-plane"; // No prefix for dedicated cluster
}
%>

configFromSecrets:
  db:
    password:
      name: "<%= secretName %>"
      key: password
  auth:
    clientID:
      name: sso-<%= it.participant.id %>-control-plane-secret
      key: clientId
<% if (it.general.oauthClientAuthMethod === "client_secret_post") { %>
    clientSecret:
      name: sso-<%= it.participant.id %>-control-plane-secret
      key: clientSecret
<% } %>

<% if (it.general.oauthClientAuthMethod === "private_key_jwt") { %>
secretMounts:
  - name: oauth-private-key
    secretName: sso-<%= it.participant.id %>-control-plane-secret
    mountPath: "/var/secrets"
    items:
      - key: "private-key.jwk"
        path: "private-key.jwk"
<% } %>

config:
  db:
    database: <%= dbName %>
    host: "<%= dbHost %>"
    username: app
  
  server:
    publicAddress: "{{ .Values.endpoint }}/api"

  auth:
    openIdConfigurationURL: "{{ .Values.ssoBridgeEndpoint }}/.well-known/openid-configuration"
    callbackURL: "{{ .Values.endpoint }}/api/auth/callback"
    redirectURL: "{{ .Values.endpoint }}/"
<% if (it.general.oauthClientAuthMethod === "private_key_jwt") { %>
    tokenEndpointAuthMethod: private_key_jwt
    privateKeyJwkFile: "/var/secrets/private-key.jwk"
<% } %>

  runtime:
    controlPlaneInteractions: automatic
  
  registry:
    useRegistry: true
    registryIntervalInMilliseconds: 300000
   
  iam:
    type: tsg
    didId: did:web:{{ .Values.wallet }}
    walletUrl: "{{ .Values.walletEndpoint }}"
    siopUrl: "{{ .Values.walletEndpoint }}/management/dcp/holder/token"
    verifyUrl: "{{ .Values.walletEndpoint }}/management/dcp/verifier/verify"
    typeFilter: <%= it.general.credentialType %>
    issuerFilter: "did:web:<%= it.general.authorityDomain %>"
  
  initCatalog:
    participantId: did:web:{{ .Values.wallet }}
    creator: did:web:{{ .Values.wallet }}
    publisher: did:web:{{ .Values.wallet }}
    title: "<%= it.participant.name %>"
    description: "<%= it.participant.name %> connector"
