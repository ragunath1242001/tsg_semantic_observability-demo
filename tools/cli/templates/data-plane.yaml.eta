<% if (it.dataPlane.tsgDataPlane) { %>
<% if (it.participant.routing === "subdomain") { %>
host: "<%= it.dataPlane.dnsPrefix ?? it.id %>.<%= it.participant.host %>"
endpoint: https://dp.<%= it.participant.host %>
ssoBridgeEndpoint: "https://sso-bridge.<%= it.participant.host %>"
controlPlaneEndpoint: "http://<%= it.participant.id %>-tsg-control-plane:3000/api"
<% } else { %>
host: "<%= it.participant.host %>"
endpoint: https://<%= it.participant.host %>/<%= it.dataPlane.subPath ?? it.id %>
ssoBridgeEndpoint: "https://<%= it.participant.host %>"
controlPlaneEndpoint: "http://<%= it.participant.id %>-tsg-control-plane:3000/control-plane/api"


subPath: /<%= it.dataPlane.subPath ?? it.id %>
<% } %>

<% 
const application = it.applications?.dataPlanes?.get(it.dataPlane.type ?? it.id);
if (application?.imageTag || application?.imageRepository) { %>
image:
<%- if (application?.imageTag) { %>
  tag: <%= application.imageTag %>
<% } %>
<%- if (application?.imageRepository) { %>
  repository: <%= application.imageRepository %>
<% } %>
<% } %>

ingress:
  enabled: true

<%
const postgresMode = it.general.postgresDeploymentMode ?? "per-participant";
const isShared = postgresMode === "per-namespace" && it.scope === "ecosystem";
let secretName, dbHost, dbName;

if (isShared) {
  secretName = "postgresql-cluster-app";
  dbHost = "postgresql-cluster-rw";
  dbName = `${it.participant.id}-${it.id}`;
} else {
  secretName = `${it.participant.id}-postgresql-app`;
  dbHost = `${it.participant.id}-postgresql-rw`;
  dbName = it.id;
}
%>

configFromSecrets:
  db:
    password:
      name: "<%= secretName %>"
      key: password
  auth:
    clientID:
      name: sso-<%= it.participant.id %>-<%= it.id %>-secret
      key: clientId
    clientSecret:
      name: sso-<%= it.participant.id %>-<%= it.id %>-secret
      key: clientSecret

config:
  db:
    type: postgres
    port: 5432
    username: app
    database: <%= dbName %>
    host: "<%= dbHost %>"

  server:
    publicAddress: "{{ .Values.endpoint }}/api"

  auth:
    openIdConfigurationURL: "{{ .Values.ssoBridgeEndpoint }}/.well-known/openid-configuration"
    callbackURL: "{{ .Values.endpoint }}/api/auth/callback"
    redirectURL: "{{ .Values.endpoint }}/"
  
  controlPlane:
    dataPlaneEndpoint: "{{ .Values.controlPlaneEndpoint }}/data-plane"
    managementEndpoint: "{{ .Values.controlPlaneEndpoint }}/management"
    controlEndpoint: "{{ .Values.controlPlaneEndpoint }}/"

  runtime:
    color: "#3B8BF6"
<% if (it.participant.hasDebugLogging) { %>
  logging:
    debug: true
<% } %>
<% } %>