<% if (it.participant.routing === "subdomain") { %>
host: "dp.<%= it.participant.host %>"
endpoint: https://dp.<%= it.participant.host %>
casdoorEndpoint: "https://casdoor.<%= it.participant.host %>"
controlPlaneEndpoint: "http://<%= it.participant.id %>-tsg-control-plane:3000/api"
<% } else { %>
host: "<%= it.participant.host %>"
endpoint: https://<%= it.participant.host %>/http-data-plane
casdoorEndpoint: "https://<%= it.participant.host %>"
controlPlaneEndpoint: "http://<%= it.participant.id %>-tsg-control-plane:3000/control-plane/api"


subPath: /http-data-plane
<% } %>

<% if (it.applications?.dataPlane?.imageTag || it.applications?.dataPlane?.imageRepository) { %>
image:
<%- if (it.applications?.dataPlane?.imageTag) { %>
  tag: <%= it.applications?.dataPlane.imageTag %>
<% } %>
<%- if (it.applications?.dataPlane?.imageRepository) { %>
  repository: <%= it.applications?.dataPlane.imageRepository %>
<% } %>
<% } %>

ingress:
  enabled: true

configFromSecrets:
  db:
    password:
      name: "<%= it.participant.id %>-postgresql"
      key: postgres-password
  auth:
    clientID:
      name: casdoor-http-data-plane-<%= it.participant.id %>-secret
      key: clientId
    clientSecret:
      name: casdoor-http-data-plane-<%= it.participant.id %>-secret
      key: clientSecret
    clientUsername:
      name: casdoor-http-data-plane-<%= it.participant.id %>-secret
      key: username
    clientPassword:
      name: casdoor-http-data-plane-<%= it.participant.id %>-secret
      key: password

config:
  db:
    type: postgres
    port: 5432
    username: postgres
    database: http-data-plane
    host: "<%= it.participant.id %>-postgresql"

  server:
    publicAddress: "{{ .Values.endpoint }}"

  auth:
    authorizationURL: "{{ .Values.casdoorEndpoint }}/login/oauth/authorize"
    tokenURL: "{{ .Values.casdoorEndpoint }}/api/login/oauth/access_token"
    introspectionURL: "{{ .Values.casdoorEndpoint }}/api/login/oauth/introspect"
    callbackURL: "{{ .Values.endpoint }}/api/auth/callback"
    rolePath: "$.roles[*].name"
    redirectURL: "{{ .Values.endpoint }}/"
  
  controlPlane:
    dataPlaneEndpoint: "{{ .Values.controlPlaneEndpoint }}/data-plane"
    managementEndpoint: "{{ .Values.controlPlaneEndpoint }}/management"
    controlEndpoint: "{{ .Values.controlPlaneEndpoint }}/"
  
<% if (it.participant.hasTestService) { %>
  dataset:
    title: "<%= it.participant.name %> HTTPBin"
    versions:
      - backend: https://httpbin.org/
        openApiSpec: https://httpbin.org/spec.json
        version: "0.9.2"
    policy:
      type: default
<% } %>
<% if (it.participant.hasDebugLogging) { %>
  logging:
    debug: true
<% } %>