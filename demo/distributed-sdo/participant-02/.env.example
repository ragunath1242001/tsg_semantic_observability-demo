# Unique identity returned by the SDO registration script.
PARTICIPANT_ID=
PARTICIPANT_DISPLAY_NAME=
SDO_API_KEY=
# Endpoint used by TSG containers to push observability events.
# For real remote SDO servers, use http://<SDO_HOST>:4100/api/ingest/events.
# For a local SDO container on the same Docker host, use http://host.docker.internal:4100/api/ingest/events.
SDO_OBSERVABILITY_ENDPOINT=

# Unique Docker Compose project name for this participant on this machine.
# Required when running multiple participants on one host for local testing.
COMPOSE_PROJECT_NAME=tsg-distributed-sdo-participant

# Public address of this participant machine, reachable by other participants.
# Use a LAN IP, DNS name, or public host name. Do not use localhost for distributed demos.
PUBLIC_HOST=192.168.1.21

# Host ports exposed by this participant.
CONTROL_PLANE_PORT=3701
DATA_PLANE_PORT=3702

# Connector role for demo documentation and scripts.
# Use provider for the participant exposing a dataset, consumer for the participant requesting it.
PARTICIPANT_ROLE=provider

# Consumer-side flow settings. Required when this participant acts as a consumer.
# REMOTE_CONTROL_PLANE_API must be reachable from this machine and must include /api.
# REMOTE_PARTICIPANT_AUDIENCE must match the provider's did:web:<PARTICIPANT_ID>.
REMOTE_CONTROL_PLANE_API=http://192.168.1.21:3701/api
REMOTE_PARTICIPANT_AUDIENCE=did:web:participant-provider
EXECUTE_PATH=get

# Local dataset metadata used by provider participants.
DATASET_TITLE=Distributed SDO Demo Dataset
DATASET_DESCRIPTION=Provider dataset used for distributed SDO semantic observability.
DATASET_BASE_SEMANTIC_MODEL_REF=https://example.org/semantic/distributed/base
DATASET_SEMANTIC_MODEL_REF=https://example.org/semantic/distributed/1.0.0
DATASET_SCHEMA_REF=https://example.org/schemas/distributed-demo-1.0.0.json
DATASET_OPENAPI_REF=https://mockhttp.org/docs/json
DATASET_BACKEND_URL=https://mockhttp.org/
